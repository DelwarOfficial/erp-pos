# ============================================================================
# ERP/POS — Production Environment (rangpurtv.com)
# Copy to .env on server: cp .env.production.example .env
# DO NOT COMMIT .env
# Fill CHANGE_ME_* and REPLACE secrets below
# ============================================================================

# ── Database (PostgreSQL 16+ PRODUCTION — external managed) ─────────────────
# Example: Neon / Supabase / RDS with sslmode
# Get from provider dashboard — must be postgresql://
DATABASE_URL="postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST:5432/erp_pos_prod?sslmode=require&schema=public"

# ── Application ────────────────────────────────────────────────────────────
NODE_ENV="production"
APP_VERSION="4.1.0"
NEXT_PUBLIC_APP_URL="https://rangpurtv.com"
HOSTNAME="0.0.0.0"
PORT="3000"

# ── Secrets — REPLACE ALL (generated 2026-08-30) ───────────────────────────
JWT_SECRET="sIsd6PEtTE0LZUDESx1j8Gw6jzn0m7DMH+FPJg2uHlYln4tLhqrPzMAhZUAXmO5A"
APP_ENCRYPTION_KEY="Yy9u6uByjifpSLaJZ9ohkibvAE9ioOBt6q6WIR7SGlc="
BARCODE_SIGNING_KEY="83a746f9eb38432a931dc895868be915630691c910e692d230794590449736ff"
CSRF_SECRET="CHANGE_ME_GENERATE_32_HEX"

# ── Redis (Upstash / managed) ──────────────────────────────────────────────
REDIS_URL="redis://CHANGE_ME_REDIS_HOST:6379"
# or rediss://default:password@host:6380 for TLS

# ── Provider Mode ──────────────────────────────────────────────────────────
PROVIDER_MODE="live"

# ── S3 Storage (R2 / S3) ───────────────────────────────────────────────────
S3_ENDPOINT="https://CHANGE_ME_R2_ENDPOINT"
S3_BUCKET="erp-pos-prod"
S3_ACCESS_KEY="CHANGE_ME"
S3_SECRET_KEY="CHANGE_ME"
S3_REGION="auto"

# ── Backup S3 ──────────────────────────────────────────────────────────────
BACKUP_S3_BUCKET="erp-pos-backups-prod"
BACKUP_RETENTION_DAYS="30"

# ── Email (pick one) ───────────────────────────────────────────────────────
RESEND_API_KEY="re_CHANGE_ME"
RESEND_FROM_EMAIL="ERP POS <noreply@rangpurtv.com>"
SENDGRID_API_KEY="SG.CHANGE_ME"
SENDGRID_FROM_EMAIL="noreply@rangpurtv.com"
SES_REGION="ap-south-1"

# ── SMS ────────────────────────────────────────────────────────────────────
