# Every secret below is a placeholder. Generate each one fresh for the deployment;
# never copy a value from this file. The server refuses to start in production with
# a placeholder, a weak JWT_SECRET, or any value that has appeared in this file
# (src/lib/config/productionGuards.ts).
# ============================================================================
# ERP/POS — Production Environment (rangpurtv.com)
# Copy to .env on server: cp .env.production.example .env
# DO NOT COMMIT .env
# Fill CHANGE_ME_* and REPLACE secrets below
# ============================================================================

# ── Database (PostgreSQL 16+ PRODUCTION — external managed) ─────────────────
# Example: Neon / Supabase / RDS with sslmode
# Get from provider dashboard — must be postgresql://
DATABASE_URL="postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST:5432/erp_pos_prod?sslmode=require&schema=public"

# ── Application ────────────────────────────────────────────────────────────
NODE_ENV="production"
APP_VERSION="4.1.0"
NEXT_PUBLIC_APP_URL="https://rangpurtv.com"
HOSTNAME="0.0.0.0"
PORT="3000"

# ── Secrets — REPLACE ALL (generated 2026-08-30) ───────────────────────────
JWT_SECRET="GENERATE_WITH_openssl_rand_base64_48"
APP_ENCRYPTION_KEY="GENERATE_WITH_openssl_rand_base64_32"
BARCODE_SIGNING_KEY="GENERATE_WITH_openssl_rand_hex_32"
CSRF_SECRET="CHANGE_ME_GENERATE_32_HEX"

# ── Redis (Upstash / managed) ──────────────────────────────────────────────
REDIS_URL="redis://CHANGE_ME_REDIS_HOST:6379"
# or rediss://default:password@host:6380 for TLS

# ── Provider Mode ──────────────────────────────────────────────────────────
PROVIDER_MODE="live"

# ── S3 Storage (R2 / S3) ───────────────────────────────────────────────────
S3_ENDPOINT="https://CHANGE_ME_R2_ENDPOINT"
S3_BUCKET="erp-pos-prod"
S3_ACCESS_KEY="CHANGE_ME"
S3_SECRET_KEY="CHANGE_ME"
S3_REGION="auto"

# ── Backup S3 ──────────────────────────────────────────────────────────────
BACKUP_S3_BUCKET="erp-pos-backups-prod"
BACKUP_RETENTION_DAYS="30"

# ── Email (pick one) ───────────────────────────────────────────────────────
RESEND_API_KEY="re_CHANGE_ME"
RESEND_FROM_EMAIL="ERP POS <noreply@rangpurtv.com>"
SENDGRID_API_KEY="SG.CHANGE_ME"
SENDGRID_FROM_EMAIL="noreply@rangpurtv.com"
SES_REGION="ap-south-1"

# ── SMS ────────────────────────────────────────────────────────────────────
SSL_SMS_API_URL="https://sms.sslwireless.com/pushapi/dynamic/server.php"
SSL_SMS_API_KEY="CHANGE_ME"
SSL_SMS_API_PASS="CHANGE_ME"
SSL_SMS_SENDER_ID="RangpurTV"
MIM_SMS_API_URL="https://api.mimsms.com/api/SmsSending/SMS"
MIM_SMS_API_KEY="CHANGE_ME"

# ── Payments (live) ────────────────────────────────────────────────────────
BKASH_API_URL="https://tokenized.pay.bka.sh/v1.2.0-beta"
BKASH_USERNAME="CHANGE_ME"
BKASH_PASSWORD="CHANGE_ME"
BKASH_APP_KEY="CHANGE_ME"
BKASH_APP_SECRET="CHANGE_ME"
NAGAD_API_URL="https://api.mynagad.com/api/dfs"
NAGAD_MERCHANT_ID="CHANGE_ME"

# ── Courier (live) ─────────────────────────────────────────────────────────
PATHAO_API_URL="https://api-hermes.pathao.com"
PATHAO_API_KEY="CHANGE_ME"
PATHAO_SECRET_KEY="CHANGE_ME"
PATHAO_STORE_ID="CHANGE_ME"
REDX_API_URL="https://openapi.redx.com.bd/v1"
REDX_API_KEY="CHANGE_ME"

# ── Webhook / Cron Auth ────────────────────────────────────────────────────
COURIER_WEBHOOK_TOKEN="GENERATE_WITH_openssl_rand_base64_32"
CRON_API_TOKEN="GENERATE_WITH_openssl_rand_base64_32"

# ── Risk / Notifications ───────────────────────────────────────────────────
RISK_ALERT_RECIPIENT_EMAIL="ops@rangpurtv.com"
SLACK_WEBHOOK_URL="CHANGE_ME"
TELEGRAM_BOT_TOKEN="CHANGE_ME"
TELEGRAM_CHAT_ID="CHANGE_ME"

# ── WebAuthn ───────────────────────────────────────────────────────────────
WEBAUTHN_RP_ID="rangpurtv.com"
WEBAUTHN_ORIGIN="https://rangpurtv.com"

# ── Observability ──────────────────────────────────────────────────────────
SENTRY_DSN="CHANGE_ME"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
OTEL_SERVICE_NAME="erp-pos-prod"

# ── Worker ─────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY="4"
RESERVATION_TTL_MINUTES="15"

# ── Feature Flags ──────────────────────────────────────────────────────────
FEATURE_CREDIT_SALES="true"
FEATURE_OFFLINE_POS="true"
FEATURE_ASSET_MANAGEMENT="false"
FEATURE_BANK_RECONCILIATION="false"
FEATURE_MULTI_CURRENCY="true"
FEATURE_PAYROLL="true"
FEATURE_CRM="true"
FEATURE_DELIVERY="true"
FEATURE_SERVICE_WARRANTY="true"
FEATURE_IMPORTS="true"
FEATURE_LOYALTY="true"
FEATURE_HR="true"
