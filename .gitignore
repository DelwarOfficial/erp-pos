.env
.env.*
!.env.example
!.env.*.example

# Local databases; schemas and migration SQL stay versioned
/db/*.db*
/db/*.sqlite*
/prisma/*.db*
/prisma/*.sqlite*
/*.db*
/*.sqlite*

# Logs and test output
*.log
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/
blob-report/

# Scratch space and machine-specific analysis caches
/.local/
/.codex-tmp/
/tool-results/
/agent-ctx/
/.zscripts/
/graphify-out/cache/
/graphify-out/.graphify_*
/graphify/
*.deb

