# docker/Dockerfile.web
# Production image for the ERP/POS web application (non-root, §6 rule 10).
#
# Targets:
#   runner  the Next.js standalone server (default)
#   tools   full dependencies + Prisma CLI, for `prisma migrate deploy`
#           (docker-compose.prod.yml service "migrate")
#
# Secrets are never baked in: they arrive as environment variables at run
# time. .dockerignore keeps .env*, .local and node_modules out of the context.

FROM node:22-slim AS base
# Prisma's query engine needs OpenSSL.
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*

FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN npx prisma generate --schema=prisma/mariadb/schema.prisma
RUN npm run build

# Migrations and other one-off database commands.
FROM builder AS tools
ENV NODE_ENV=production
USER node

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN groupadd --system --gid 1001 nodejs && useradd --system --uid 1001 --gid nodejs --create-home nextjs

COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
# The generated Prisma client and its engine, in case file tracing missed them.
COPY --from=builder --chown=nextjs:nodejs /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder --chown=nextjs:nodejs /app/node_modules/@prisma/client ./node_modules/@prisma/client

USER nextjs
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
CMD ["node", "server.js"]
