# docker/Caddyfile — HTTPS in front of the web container.
# Caddy obtains and renews the certificate for $APP_DOMAIN itself (ports 80
# and 443 must reach this VPS, and the domain's A record must point here).
{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip
	# The app sets its own CSP, cookies and security headers; these are the transport ones.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	request_body {
		max_size 20MB
	}
	reverse_proxy web:3000 {
		header_up X-Forwarded-Proto {scheme}
	}
	log {
		output stdout
		format json
	}
}
