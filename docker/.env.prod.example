# docker/.env.prod.example — the settings docker-compose.prod.yml needs.
#
# Do not fill this file in. On the VPS, run scripts/deploy/gen-secrets.sh: it
# writes docker/.env.prod (mode 600) with fresh random secrets and refuses to
# overwrite an existing one. Then set the non-secret values below by hand.
# docker/.env.prod is git-ignored and Docker-ignored; never commit or copy it.

# ── You set these ──
APP_DOMAIN=            # e.g. erp.example.com (A record → this VPS)
ACME_EMAIL=            # Let's Encrypt account / expiry notices
APP_VERSION=           # image tag, e.g. the git commit
DB_NAME=erp_pos
DB_USER=erp_app
DB_BUFFER_POOL=1G      # about half the VPS RAM if MariaDB is the main user

# ── gen-secrets.sh generates these (each 32+ random bytes) ──
DB_PASSWORD=
DB_ROOT_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
APP_ENCRYPTION_KEY=
BARCODE_SIGNING_KEY=
CRON_API_TOKEN=

# ── Optional ──
SENTRY_DSN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RISK_ALERT_RECIPIENT_EMAIL=
# Offsite backups (scripts/deploy/backup.sh): an rclone remote, e.g. "b2:erp-pos-backups"
BACKUP_RCLONE_REMOTE=
