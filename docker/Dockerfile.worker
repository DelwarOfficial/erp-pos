# docker/Dockerfile.worker
# Worker process: outbox delivery, daily reconciliation + risk alerts,
# reservations, retention, due reminders, SMS sending (src/workers/index.ts).

FROM node:22-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*

FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npx prisma generate --schema=prisma/mariadb/schema.prisma

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 worker
# Installed at build time: npx would otherwise download tsx on every start.
RUN npm install -g tsx@4

COPY --from=builder --chown=worker:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=worker:nodejs /app/src ./src
COPY --from=builder --chown=worker:nodejs /app/prisma ./prisma
COPY --from=builder --chown=worker:nodejs /app/package.json ./
# tsx resolves the @/ path alias from tsconfig.json.
COPY --from=builder --chown=worker:nodejs /app/tsconfig.json ./

USER worker
CMD ["tsx", "src/workers/index.ts"]
