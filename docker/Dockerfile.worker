# docker/Dockerfile.worker
# Worker process for outbox delivery, reconciliation, retention, offline sync.

FROM node:20-slim AS base

FROM base AS deps
WORKDIR /app
COPY package.json bun.lock ./
RUN npm install --frozen-lockfile

FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npx prisma generate

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 worker

COPY --from=builder --chown=worker:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=worker:nodejs /app/src ./src
COPY --from=builder --chown=worker:nodejs /app/prisma ./prisma
COPY --from=builder --chown=worker:nodejs /app/package.json ./
# tsx resolves the @/ path alias from tsconfig.json; without it every import
# in src/workers/index.ts fails at startup.
COPY --from=builder --chown=worker:nodejs /app/tsconfig.json ./

# Installed at build time: npx would otherwise download tsx on every container
# start, as a non-root user, and fail with no network.
RUN npm install -g tsx@4

USER worker

# src/workers/index.ts is the orchestrator that starts every BullMQ worker.
# outboxWorker.ts only exports functions and exits immediately when run.
CMD ["tsx", "src/workers/index.ts"]
